+++ b/apps/hr/templates/request_form.html
@@ -0,0 +1,14 @@
+{% extends "base.html" %}{% block title %}Buat pengajuan{% endblock %}{% block content %}
+<h2>Buat pengajuan</h2>
+<form method="post" class="card form">{% csrf_token %}
+{{ form.non_field_errors }}
+{% for f in form %}<div class="fld" data-f="{{ f.name }}"><label for="{{ f.id_for_label }}">{{ f.label }}</label>{{ f }}{{ f.errors }}</div>{% endfor %}
+<p><button name="draft">Simpan draft</button> <button name="submit" value="1">Ajukan ke HRD</button></p></form>
+{{ fields_by_type|json_script:"fbt" }}
+<script>
+const fbt=JSON.parse(document.getElementById("fbt").textContent),sel=document.getElementById("id_type");
+const always=["type","nik"];
+function sync(){const use=fbt[sel.value]||[];
+document.querySelectorAll(".fld").forEach(d=>{d.hidden=!(always.includes(d.dataset.f)||use.includes(d.dataset.f))});}
+sel.onchange=sync;sync();
+</script>{% endblock %}
diff --git a/apps/hr/templates/requests_list.html b/apps/hr/templates/requests_list.html
new file mode 100644
index 0000000..0723dca
--- /dev/null
+++ b/apps/hr/templates/requests_list.html
@@ -0,0 +1,14 @@
+{% extends "base.html" %}{% block title %}Pengajuan{% endblock %}{% block content %}
+<h2>Pengajuan <a class="btn" href="/requests/new/">+ Buat pengajuan</a></h2>
+<form method="get" class="bar"><input name="q" value="{{ f.q }}" placeholder="Cari NIK / nama">
+<select name="status"><option value="">Semua status</option>{% for k, v in statuses.items %}<option value="{{ k }}"{% if f.status == k %} selected{% endif %}>{{ v }}</option>{% endfor %}</select>
+<select name="type"><option value="">Semua jenis</option>{% for k, v in types.items %}<option value="{{ k }}"{% if f.type == k %} selected{% endif %}>{{ v }}</option>{% endfor %}</select>
+<button>Filter</button></form>
+<div class="wrap"><table><thead><tr><th>#</th><th>Jenis</th><th>Karyawan</th><th>Departemen</th><th>Status</th><th>Diajukan oleh</th><th>Tanggal</th></tr></thead><tbody>
+{% for r in page %}<tr><td><a href="/requests/{{ r.pk }}/">{{ r.pk }}</a></td><td>{{ r.type }}</td><td>{{ r.employee.nik }} · {{ r.employee.name }}</td><td>{{ r.department.name }}</td>
+<td><span class="pill {{ r.status }}">{{ r.status_label }}</span></td><td>{{ r.requested_by.get_username }}</td><td>{{ r.created_at|date:"d M Y H:i" }}</td></tr>
+{% empty %}<tr><td colspan="7">Belum ada pengajuan.</td></tr>{% endfor %}</tbody></table></div>
+<p>{% if page.has_previous %}<a class="btn" href="?page={{ page.previous_page_number }}&q={{ f.q|urlencode }}&status={{ f.status }}&type={{ f.type }}">‹</a>{% endif %}
+Halaman {{ page.number }} / {{ page.paginator.num_pages }} · {{ page.paginator.count }} data
+{% if page.has_next %}<a class="btn" href="?page={{ page.next_page_number }}&q={{ f.q|urlencode }}&status={{ f.status }}&type={{ f.type }}">›</a>{% endif %}</p>
+{% endblock %}
