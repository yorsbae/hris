DJANGO_SECRET_KEY=ganti-dengan-random-panjang
DJANGO_DEBUG=False
ALLOWED_HOSTS=hris.lan,192.168.1.10
DATABASE_URL=postgres://hris:password@127.0.0.1:5432/hris
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  → SIMPAN di tempat aman & ikut backup terpisah dari DB
FIELD_ENCRYPTION_KEY=
# Di belakang Nginx (README): IP proxy dipisah koma (IP atau CIDR). Tanpa ini audit/rate limit melihat semua request sebagai 127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1
# Situs dilayani lewat HTTPS? (True → cookie sesi/CSRF hanya lewat HTTPS; Nginx wajib mengirim & menimpa X-Forwarded-Proto)
HTTPS=False
CSRF_TRUSTED_ORIGINS=
