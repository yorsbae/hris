DJANGO_SECRET_KEY=ganti-dengan-random-panjang
DJANGO_DEBUG=False
ALLOWED_HOSTS=hris.lan,192.168.1.10
DATABASE_URL=postgres://hris:password@127.0.0.1:5432/hris
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  → SIMPAN di tempat aman & ikut backup terpisah dari DB
FIELD_ENCRYPTION_KEY=
# Di belakang Nginx (README): IP proxy dipisah koma (IP atau CIDR). Tanpa ini audit/rate limit melihat semua request sebagai 127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1
# Situs dilayani lewat HTTPS? (True → cookie sesi/CSRF hanya lewat HTTPS; Nginx wajib mengirim & menimpa X-Forwarded-Proto)
HTTPS=False
CSRF_TRUSTED_ORIGINS=
# --- Keamanan (putaran 21, P1). Semua opsional; angka = usulan awal.
# Cache bersama untuk rate limit/throttle. WAJIB bila gunicorn >1 worker (tanpa ini hitungan per proses → batas efektif = batas × jumlah worker).
REDIS_URL=
# Sesi berakhir bila tidak ada aktivitas selama N menit (0 = nonaktif)
SESSION_IDLE_MINUTES=30
# Salah sandi berturut-turut sebelum akun dikunci sementara (1, 5, 15, 60, 240 menit progresif)
LOGIN_LOCK_THRESHOLD=8
# HSTS (hanya berlaku bila HTTPS=True). Naikkan bertahap: 300 → 86400 → 31536000. 0 = nonaktif
HSTS_SECONDS=0
# CSP bawaan sudah aman untuk aplikasi ini. JANGAN isi CSP_POLICY dengan nilai kosong: nilai kosong = CSP DIMATIKAN. Hapus/komentari baris ini untuk memakai bawaan.
# CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; ...

# --- Kop & penanda tangan surat cetak (surat Poli: izin pulang/libur/hamil + rujukan; Surat Peringatan HRD). Tanpa ini kop memakai "PT X".
COMPANY_NAME=PT. SUKOREJO INDAH TEXTILE
COMPANY_TAGLINE=EXPORT - IMPORT - MANUFACTURE - GENERAL TRADING
COMPANY_ADDRESS=Jl. Raya Kandeman Km. 4,5 Kandeman - Batang 51261, Jawa Tengah, Telp. (0285) 392884 / 4493084 - Fax. (0285) 392583
POLI_TAGLINE=PELAYANAN KESEHATAN KARYAWAN
# Kota untuk baris "Kota, tanggal" di surat Poli (mis. Batang). Kosong → hanya tanggal
COMPANY_CITY=
# Kosong → "POLIKLINIK <COMPANY_NAME>"
POLI_NAME=
# Dokter perusahaan: bila diisi, surat Poli ditandatangani "Dokter Perusahaan"; kosong → nama pengguna Poli yang membuat surat
POLI_DOCTOR_NAME=
HRD_SIGNER_NAME=
HRD_SIGNER_TITLE=Manager HRD
# Cadangan untuk surat persetujuan cuti hamil (suratnya belum dibuat)
PERSONALIA_SIGNER_NAME=
PERSONALIA_SIGNER_TITLE=Kabag Personalia

# --- Absensi / Fingerspot (putaran 48). Semua opsional; angka = usulan awal (lihat docs/PROGRESS.md A100–A110)
# ATTENDANCE_MAX_UPLOAD_MB=30           # batas unggahan berkas (Nginx: client_max_body_size harus >= ini)
# ATTENDANCE_MAX_ROWS=400000            # batas baris per berkas
# ATTENDANCE_DEFAULT_DEVICE=FINGERSPOT  # nama mesin bila berkas tidak punya kolom mesin
# ATTENDANCE_LATE_GRACE_MIN=0           # toleransi terlambat (menit)
# ATTENDANCE_IN_BEFORE_MIN=240          # scan sampai N menit sebelum jam masuk dihitung ke hari kerja itu
# ATTENDANCE_OUT_AFTER_MIN=360          # scan sampai N menit setelah jam pulang dihitung ke hari kerja itu
# ATTENDANCE_MIN_GAP_MIN=30             # dua scan lebih dekat dari ini = satu kejadian (ketukan ganda)
# ATTENDANCE_EXTRA_MIN_MINUTES=30       # kelebihan jam di bawah ini diabaikan
# ATTENDANCE_OT_TOLERANCE_MIN=15        # selisih jam scan vs lembur disetujui yang masih dianggap sah

# --- Company Profile & Lamar Kerja (putaran 48, Tahap 11). Lihat docs/DEPLOY-PUBLIK.md
# internal = aplikasi HRIS (bawaan); public = situs publik di host terpisah (hanya profil + karir)
SITE_MODE=internal
# Alamat situs publik (dipakai di tautan email pelamar & sitemap), mis. https://wadimor.co.id
PUBLIC_BASE_URL=
# Pratinjau situs (draf ikut tampil untuk HRD/Superadmin) di aplikasi internal: /situs/
PUBLIC_PREVIEW=True
# Folder CV pelamar (terenkripsi). Jangan diarahkan ke folder yang disajikan Nginx.
# PRIVATE_MEDIA_ROOT=/opt/hris/private_media
CAREER_MAX_UPLOAD_MB=3
CAREER_RETENTION_MONTHS=12
CAREER_REQUIRE_EMAIL_VERIFY=True
# Pemindai antivirus ClamAV (clamd), mis. unix:/var/run/clamav/clamd.ctl atau tcp:127.0.0.1:3310. Kosong = berkas ditandai "unscanned".
CLAMAV_ADDRESS=
# Email ke pelamar (bawaan: dicetak ke konsol). Produksi: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@localhost
# Bukti pengajuan (foto/berkas, ekstensi bebas): batas per berkas (MB) dan jumlah berkas per pengajuan. Samakan client_max_body_size Nginx.
REQUEST_ATTACH_MAX_MB=50
# Tagihan berobat (Poli): persen BAWAAN bagian PERUSAHAAN untuk penanggung BPJS; sisanya karyawan. Non BPJS = 100% perusahaan. Persen per tanggal berlaku: menu Poli → Master Tanggungan.
POLI_BPJS_COMPANY_PCT=75
REQUEST_ATTACH_MAX_FILES=10

# --- Pemantauan (lihat docs/PROGRESS.md putaran 61) ---
# Alarm: backup gagal & health check gagal. Isi salah satu/keduanya. Webhook = Slack/Mattermost/Discord (JSON {text, content}).
ALERT_WEBHOOK_URL=
ALERT_EMAILS=
# Backup: berkas status ditulis scripts/backup.sh; aktifkan REQUIRE di produksi agar "belum pernah backup" dianggap GAGAL
BACKUP_STATUS_FILE=/var/backups/hris/status.json
BACKUP_MAX_AGE_HOURS=26
HEALTH_REQUIRE_BACKUP=False
# Latihan restore otomatis (scripts/restore_drill.sh, bulanan): hasilnya dipantau /health/. Salinan backup di luar mesin: BACKUP_RSYNC_TARGET (di .env yang dibaca backup.sh)
DRILL_STATUS_FILE=/var/backups/hris/restore_drill.json
DRILL_MAX_AGE_DAYS=35
HEALTH_REQUIRE_DRILL=False
# BACKUP_RSYNC_TARGET=user@mesin-lain:/data/hris-backup/
# PRIVATE_MEDIA_ROOT=/opt/hris/private_media
HEALTH_MIN_FREE_MB=500
# Log: app.log (semua) + errors.log (hanya ERROR+traceback). LOG_DIR bawaan = folder aplikasi.
LOG_DIR=
# Traceback 5xx via email (opsional; butuh EMAIL_*) dan pelacakan error eksternal (opsional; pip install sentry-sdk)
ADMIN_EMAILS=
SENTRY_DSN=

# --- Sinkronisasi dengan situs publik (lihat docs/DEPLOY-PUBLIK.md). Situs publik memakai .env TERSENDIRI: deploy/public/env.example
SYNC_SHARED_SECRET=          # >=32 karakter acak; sama di HRIS & host publik; BEDA dari DJANGO_SECRET_KEY
PULL_STATE_FILE=

# Mesin Fingerspot protokol FK (port 5005) — pakai FKAttend.dll dari Fingerspot Personnel (Windows). DLL 32-bit → butuh python.exe 32-bit.
ATTENDANCE_FK_DLL=
ATTENDANCE_FK_PYTHON32=
