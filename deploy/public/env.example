# .env HOST PUBLIK (internet). Rahasia di sini BEDA dari HRIS. Izin berkas: chmod 600, pemilik = user layanan.
DJANGO_SETTINGS_MODULE=config.settings_public
DJANGO_SECRET_KEY=                 # acak panjang, BEDA dari HRIS
DJANGO_DEBUG=False
ALLOWED_HOSTS=wadimor.co.id,www.wadimor.co.id
HTTPS=True
CSRF_TRUSTED_ORIGINS=https://wadimor.co.id
PUBLIC_BASE_URL=https://wadimor.co.id
DATABASE_URL=postgres://pub_user:GANTI@127.0.0.1:5432/wadimor_public   # DB SENDIRI di host ini; BUKAN database HRIS
FIELD_ENCRYPTION_KEY=              # kunci BARU khusus host publik (BUKAN kunci HRIS). Dipakai mengenkripsi lamaran sementara sebelum ditarik HRIS
SYNC_SHARED_SECRET=                # >=32 karakter acak; SAMA dengan di HRIS. Menandatangani bundle konten
REDIS_URL=redis://127.0.0.1:6379/1 # WAJIB (rate limit bersama antarworker)
TRUSTED_PROXY_IPS=127.0.0.1        # + IP Cloudflare bila dipakai (lihat docs/DEPLOY-PUBLIK.md); tanpa ini IP pengunjung = IP proxy
MEDIA_ROOT=/srv/wadimor/media              # gambar situs (hasil impor bundle); Nginx menyajikan LANGSUNG, mount noexec
PRIVATE_MEDIA_ROOT=/srv/wadimor/private    # CV terenkripsi sementara; JANGAN disajikan Nginx
SYNC_STATE_FILE=/srv/wadimor/state/sync_serial
LOG_DIR=/var/log/wadimor
CLAMAV_ADDRESS=unix:/var/run/clamav/clamd.ctl
CAREER_AV_REQUIRED=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=karir@wadimor.co.id
HSTS_SECONDS=300                   # naikkan bertahap: 300 -> 86400 -> 31536000
