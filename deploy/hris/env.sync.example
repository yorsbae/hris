# Tambahan .env HRIS (LAN) untuk sinkronisasi dengan situs publik
SYNC_SHARED_SECRET=                # SAMA dengan host publik
PULL_STATE_FILE=/var/lib/hris/pull_cursor
PUBLIC_BASE_URL=https://wadimor.co.id   # tautan lacak status di email yang dikirim HRIS
PUBLIC_PREVIEW=True                     # pratinjau draf di /situs/ (hanya login HRD/Superadmin)
