# Contoh Nginx di depan gunicorn (putaran 21, P1). Salin ke /etc/nginx/conf.d/hris.conf lalu sesuaikan server_name, sertifikat, dan path.
# Wajib: .env → TRUSTED_PROXY_IPS=127.0.0.1, HTTPS=True (bila TLS), CSRF_TRUSTED_ORIGINS=https://hris.lan. Angka di bawah = USULAN awal; setel setelah uji beban.
limit_req_zone  $binary_remote_addr zone=hris_login:10m rate=10r/m;
limit_req_zone  $binary_remote_addr zone=hris_api:10m   rate=10r/s;
limit_req_zone  $binary_remote_addr zone=hris_all:10m   rate=20r/s;
limit_conn_zone $binary_remote_addr zone=hris_conn:10m;
limit_req_status 429;
limit_conn_status 429;

server {
    listen 80;
    server_name hris.lan;
    return 301 https://$host$request_uri;      # pengalihan HTTP→HTTPS dilakukan di sini (security.W008 sengaja dibungkam di Django)
}

server {
    listen 443 ssl http2;
    server_name hris.lan;
    ssl_certificate     /etc/ssl/hris/fullchain.pem;
    ssl_certificate_key /etc/ssl/hris/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 10m;                   # unggahan maks 5 MB (+ overhead form); impor CSV/XLSX 5 MB
    limit_conn hris_conn 30;

    location = /login/        { limit_req zone=hris_login burst=5 nodelay;  include /etc/nginx/hris_proxy.conf; }
    location = /admin/login/  { limit_req zone=hris_login burst=5 nodelay;  include /etc/nginx/hris_proxy.conf; }
    location /api/            { limit_req zone=hris_api   burst=40 nodelay; include /etc/nginx/hris_proxy.conf; }
    location /                { limit_req zone=hris_all   burst=60 nodelay; include /etc/nginx/hris_proxy.conf; }
}

# /etc/nginx/hris_proxy.conf:
#   proxy_pass http://127.0.0.1:8000;
#   proxy_set_header Host $host;
#   proxy_set_header X-Real-IP $remote_addr;
#   proxy_set_header X-Forwarded-For $remote_addr;      # TIMPA (bukan $proxy_add_x_forwarded_for) bila Nginx adalah proxy terluar
#   proxy_set_header X-Forwarded-Proto $scheme;         # Django memercayai header ini hanya bila HTTPS=True
#   proxy_read_timeout 60s;
