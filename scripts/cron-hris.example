# Contoh crontab untuk HRIS (salin ke `crontab -e` pengguna layanan; sesuaikan PATH dan virtualenv).
# Semua perintah aman dijalankan berulang (notifikasi belum-dibaca tidak menumpuk).
HRIS=/path/hris
PY=/path/venv/bin/python
# 07:00 — pengingat validasi kehadiran (Admin Dept saat batas besok/terlambat; HRD saat terlambat)
0 7 * * * cd $HRIS && $PY manage.py remind_attendance_checks
# 07:05 — pengingat pengajuan Stand By & Lembur yang belum diputuskan HRD (tanggal kerja besok/lewat)
5 7 * * * cd $HRIS && $PY manage.py remind_extra_work
# 07:10 — pengingat kontrak yang akan berakhir
10 7 * * * cd $HRIS && $PY manage.py check_contracts
# 00:20 — nonaktifkan karyawan yang hari terakhir kerjanya sudah lewat (Karyawan Keluar)
20 0 * * * cd $HRIS && $PY manage.py apply_separations
# 1 Januari 00:30 — jatah cuti tahunan
30 0 1 1 * cd $HRIS && $PY manage.py grant_annual_leave
# 00:30 — olah rekap absensi harian dari log mesin (3 hari terakhir; idempoten)
30 0 * * * cd $HRIS && $PY manage.py process_attendance
# 00:10 — (opsional) impor otomatis semua berkas Fingerspot baru dari folder bersama (yang sudah pernah diimpor dilewati)
10 0 * * * cd $HRIS && $PY manage.py import_attendance /data/fingerspot/ --commit
# 02:00 — retensi data pelamar (UU PDP): anonimkan lamaran lewat masa simpan & yang tak pernah diverifikasi (jalankan di host/aplikasi yang memegang database lamaran)
0 2 * * * cd $HRIS && $PY manage.py purge_applicants
# --- Pemantauan (putaran 61) ---
# Tiap 10 menit: periksa database, migrasi, cache, disk, kunci enkripsi, dan UMUR BACKUP; kirim alarm (webhook/email di .env) saat gagal/pulih (anti-banjir).
# Ini juga yang menangkap backup yang tidak berjalan sama sekali (cron/mesin mati): backup.sh sendiri tidak bisa mengabari bila ia tidak jalan.
*/10 * * * * cd $HRIS && $PY manage.py check_health --notify >/dev/null 2>&1
# 01:00 — backup harian (menulis /var/backups/hris/status.json; gagal → alarm langsung + kode keluar 1). Sesuaikan HRIS_HOME/PY bila bukan /opt/hris.
0 1 * * * HRIS_HOME=/opt/hris PY=/opt/hris/venv/bin/python /opt/hris/scripts/backup.sh
# 03:00 tanggal 1 — LATIHAN RESTORE: pulihkan backup terbaru ke DB sementara, verifikasi (baris semua tabel, kunci enkripsi, payroll), buang. Gagal → alarm.
0 3 1 * * HRIS_HOME=/opt/hris PY=/opt/hris/venv/bin/python /opt/hris/scripts/restore_drill.sh
# Salinan di luar mesin: isi BACKUP_RSYNC_TARGET di /opt/hris/.env (backup.sh akan rsync tiap backup; gagal salin = backup GAGAL + alarm).
