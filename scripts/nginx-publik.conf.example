# Contoh Nginx untuk SITUS PUBLIK (SITE_MODE=public) — host TERPISAH dari aplikasi internal hris.lan (lihat docs/DEPLOY-PUBLIK.md).
# Sertifikat TLS wajib; HSTS dinaikkan bertahap. Angka = USULAN awal.
limit_req_zone  $binary_remote_addr zone=pub_all:10m   rate=10r/s;
limit_req_zone  $binary_remote_addr zone=pub_apply:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=pub_conn:10m;
limit_req_status 429; limit_conn_status 429;

server { listen 80; server_name wadimor.co.id www.wadimor.co.id; return 301 https://wadimor.co.id$request_uri; }

server {
    listen 443 ssl http2;
    server_name wadimor.co.id;
    ssl_certificate     /etc/ssl/wadimor/fullchain.pem;
    ssl_certificate_key /etc/ssl/wadimor/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=300" always;     # naikkan bertahap: 300 → 86400 → 31536000
    client_max_body_size 4m;                                      # CV maks CAREER_MAX_UPLOAD_MB (3) + overhead form
    limit_conn pub_conn 20;

    location /static/ { alias /srv/wadimor/static_root/; expires 7d; access_log off; }       # python manage.py collectstatic
    location /media/  { proxy_pass http://127.0.0.1:8100; include /etc/nginx/pub_proxy.conf; expires 1d; }   # gambar situs saja (company/…); CV TIDAK pernah di sini
    location ~ ^(/en)?/karir/[^/]+/lamar/$ { limit_req zone=pub_apply burst=3 nodelay; include /etc/nginx/pub_proxy.conf; proxy_pass http://127.0.0.1:8100; }
    location /        { limit_req zone=pub_all burst=30 nodelay; include /etc/nginx/pub_proxy.conf; proxy_pass http://127.0.0.1:8100; }
}
# /etc/nginx/pub_proxy.conf:
#   proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme; proxy_read_timeout 30s;
# Opsional (disarankan untuk lonjakan): proxy_cache untuk GET halaman (Django sudah mengirim Cache-Control: public, max-age=60 hanya untuk halaman statis).
